{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hideout.schema.json",
  "type": "object",
  "required": ["version", "upgrades"],
  "properties": {
    "version": { "const": 1 },
    "upgrades": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["facilityId", "level", "requirements", "prerequisites"],
        "properties": {
          "facilityId": { "type": "string", "minLength": 1 },
          "level": { "type": "integer", "minimum": 1 },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["itemId", "quantity"],
              "properties": {
                "itemId": { "type": "string", "minLength": 1 },
                "quantity": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["facilityId", "level"],
              "properties": {
                "facilityId": { "type": "string", "minLength": 1 },
                "level": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
